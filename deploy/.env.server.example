NODE_ENV=production
PORT=8787
MONGODB_URI=mongodb://secure_notes_app:REPLACE_WITH_ENCODED_DB_PASSWORD@127.0.0.1:27017/secure_notes_db?authSource=secure_notes_db&replicaSet=rs0&directConnection=true
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=secure-notes-api
JWT_AUDIENCE=secure-notes-client
CORS_ORIGIN=http://localhost:5173
# samiulenterprise.com: verify HTTP on 8787 first; preserve existing database credentials.
# Enable HTTPS after the certificate is current by setting both variables:
# TLS_PFX_PATH=/etc/secure-notes-api/springboot.p12
# TLS_PFX_PASSWORD=your-p12-password
