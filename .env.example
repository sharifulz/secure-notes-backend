NODE_ENV=development
PORT=4000
# Optional: bind to a specific interface; trust only a local Nginx proxy.
API_HOST=0.0.0.0
TRUST_PROXY=off
MONGODB_URI=mongodb://secure_notes_app:REPLACE_WITH_ENCODED_DB_PASSWORD@127.0.0.1:27018/secure_notes_db?authSource=secure_notes_db&replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=secure-notes-api
JWT_AUDIENCE=secure-notes-client
CORS_ORIGIN=http://localhost:5173
# Local development tunnel: ssh -N -L 27018:127.0.0.1:27017 root@samiulenterprise.com
# Optional HTTPS: configure both values, or leave both unset for HTTP.
# TLS_PFX_PATH=/etc/secure-notes-api/springboot.p12
# TLS_PFX_PASSWORD=your-p12-password
# Set only when running seed commands; never commit real passwords.
# SEED_ADMIN_EMAIL=admin@notes.test
# SEED_ADMIN_NAME=System Admin
# SEED_ADMIN_PASSWORD=
# SEED_USER_EMAIL=rahim@notes.test
# SEED_USER_PASSWORD=
